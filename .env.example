# Local PostgreSQL (example credentials for development)
POSTGRES_DB=currency_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ports exposed on the host
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Used only by docker-compose.db.dev.yml
POSTGRES_PORT=5433

# Backend (optional overrides)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
